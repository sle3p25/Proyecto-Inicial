comment0.target=SlotMachineC1Test
comment1.target=void setUp()
comment1.text=\r\n Sets up the test fixture before each test execution.\r\n Initializes a fresh SlotMachine instance.\r\n
comment10.target=void accordingPgRpShouldFailToPlaceNonExistingSymbol()
comment10.text=\r\n Verifies that placing a symbol that does not exist on the wheel\r\n fails instead of silently succeeding.\r\n
comment11.target=void accordingPgRpShouldSpinSingleWheelSuccessfully()
comment11.text=\r\n Verifies that spinning a single wheel with just one symbol always\r\n lands on that symbol and reports success.\r\n
comment12.target=void accordingPgRpShouldFailToSpinSingleWheelWhenNoWheelsExist()
comment12.text=\r\n Verifies that spinning a wheel when there are no wheels fails\r\n instead of throwing an unhandled exception.\r\n
comment13.target=void accordingPgRpShouldSpinAllWheels()
comment13.text=\r\n Verifies that spinning all wheels moves every wheel that has\r\n symbols to spin.\r\n
comment14.target=void accordingPgRpShouldFailToSpinAllWheelsWhenNoWheelsExist()
comment14.text=\r\n Verifies that spinning all wheels when there are no wheels fails\r\n instead of throwing an unhandled exception.\r\n
comment15.target=void accordingPgRpShouldListAllSymbolsAcrossWheels()
comment15.text=\r\n Verifies that symbols() lists every symbol on every wheel, in the\r\n order they were added.\r\n
comment16.target=void accordingPgRpShouldCountDistinctSymbolsCurrentlyShowing()
comment16.text=\r\n Verifies that distinctSymbols() counts distinct colors currently\r\n showing across wheels (their configuration), not colors sitting\r\n unused in a wheel's inventory.\r\n
comment17.target=void accordingPgRpShouldNotCountWheelsWithNoCurrentSymbol()
comment17.text=\r\n Verifies that a wheel which has never spun or been placed (still\r\n showing no color) is not counted as an extra distinct symbol.\r\n
comment18.target=void accordingPgRpShouldDetectJackpotWhenAllWheelsShowSameSymbol()
comment18.text=\r\n Verifies that the machine reports a jackpot when every wheel shows\r\n the same symbol.\r\n
comment19.target=void accordingPgRpShouldNotDetectJackpotWhenWheelsDiffer()
comment19.text=\r\n Verifies that the machine does not report a jackpot when the\r\n wheels show different symbols.\r\n
comment2.target=void accordingPgRpShouldAddWheelAtGivenPosition()
comment2.text=\r\n Verifies that adding wheels grows the machine's configuration by one\r\n entry per wheel.\r\n
comment3.target=void accordingPgRpShouldFailToDeleteWheelWhenMachineIsEmpty()
comment3.text=\r\n Verifies that deleting a wheel from an empty machine fails instead\r\n of throwing an unhandled exception.\r\n
comment4.target=void accordingPgRpShouldDeleteWheelAtGivenPosition()
comment4.text=\r\n Verifies that deleting a wheel removes exactly that wheel from the\r\n configuration.\r\n
comment5.target=void accordingPgRpShouldFailToAddSymbolWhenNoWheelsExist()
comment5.text=\r\n Verifies that adding a symbol when there are no wheels fails\r\n instead of throwing an unhandled exception.\r\n
comment6.target=void accordingPgRpShouldAddSymbolToWheel()
comment6.text=\r\n Verifies that a symbol added to a wheel shows up in the machine's\r\n full symbol list.\r\n
comment7.target=void accordingPgRpShouldRemoveExistingSymbol()
comment7.text=\r\n Verifies that removing an existing symbol takes it out of the\r\n machine's full symbol list.\r\n
comment8.target=void accordingPgRpShouldFailToRemoveNonExistingSymbol()
comment8.text=\r\n Verifies that removing a symbol that is not on any wheel fails\r\n instead of silently succeeding.\r\n
comment9.target=void accordingPgRpShouldPlaceExistingSymbolAsCurrent()
comment9.text=\r\n Verifies that placing an existing symbol makes it the wheel's\r\n current symbol.\r\n
